{
  "name": "@deepseek-ai/dsh-task-app",
  "description": "Durable plugin-owned task task-app",
  "version": "0.1.5-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./administration": {
      "types": "./lib/types/administration.d.ts",
      "default": "./lib/administration.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/administration.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-task-session": "workspace:^",
    "@deepseek-ai/dsh-task-agent": "workspace:^",
    "@deepseek-ai/dsh-task-session-persistence-jsonl": "workspace:^",
    "@deepseek-ai/dsh-task-agent-loop": "workspace:^",
    "@deepseek-ai/dsh-task-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-task-local": "workspace:^",
    "@deepseek-ai/dsh-tool-task-dispatch": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.3.6",
    "@deepseek-ai/dsh-task-api-gateway": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-workspace": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "commander": "^14.0.0",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-tool-subagent": "workspace:^",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/task-app"
  }
}
